{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "test/**", "*.json", "*.mjs", ".github/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double", "arrowParentheses": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
